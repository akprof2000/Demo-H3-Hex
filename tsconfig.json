{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "declaration": true,
    "rootDir": ".",
    "outDir": "dist",
    "paths": { "react-h3-map": ["./src/index.ts"] }
  },
  "include": ["src", "example"]
}
